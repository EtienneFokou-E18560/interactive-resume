# Public site URL (SEO + Open Graph). On Vercel, leave unset to use
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automatically, or set your
# custom domain (e.g. https://www.etiennefokouresume.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — contact form email delivery via Resend
# Set these in the Vercel dashboard: Project → Settings → Environment Variables
RESEND_API_KEY=
CONTACT_EMAIL=etienne56@gmail.com
